{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install dependencies",
      "type": "npm",
      "script": "install",
      "problemMatcher": []
    },
    {
      "label": "Dev: client + server (hot reload)",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^__never_matches__$" },
        "background": {
          "activesBegin": ".",
          "beginsPattern": ".",
          "endsPattern": "Local:"
        }
      },
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Run tests",
      "type": "npm",
      "script": "test",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Lint",
      "type": "npm",
      "script": "lint",
      "problemMatcher": ["$eslint-stylish"]
    },
    {
      "label": "Build for production",
      "type": "npm",
      "script": "build",
      "problemMatcher": []
    },
    {
      "label": "Production: build + start (http://localhost:3001)",
      "type": "shell",
      "command": "npm run build && npm start",
      "isBackground": true,
      "problemMatcher": {
        "owner": "server",
        "pattern": { "regexp": "^__never_matches__$" },
        "background": {
          "activesBegin": ".",
          "beginsPattern": ".",
          "endsPattern": "listening on port"
        }
      }
    },
    {
      "label": "Package release folder",
      "type": "npm",
      "script": "package",
      "problemMatcher": []
    }
  ]
}
