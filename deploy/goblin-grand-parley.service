# systemd unit — keeps the game server running and restarts it on crash/reboot.
# Install:  sudo cp deploy/goblin-grand-parley.service /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now goblin-grand-parley
[Unit]
Description=Goblin Grand Parley game server
After=network.target

[Service]
Type=simple
User=goblin
WorkingDirectory=/opt/goblin-grand-parley
ExecStart=/usr/bin/node dist-server/index.mjs
Environment=NODE_ENV=production
Environment=PORT=3001
# Only listen locally; nginx in front handles the public traffic + HTTPS.
Environment=HOST=127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
